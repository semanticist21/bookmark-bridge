{
  "manifest_version": 3,
  "name": "Bridgey \u2014 Bookmark MCP",
  "version": "3.0.0",
  "description": "Lets a local MCP client read and tidy your Chrome bookmarks through Native Messaging.",
  "permissions": [
    "bookmarks",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bridgey (Bookmark MCP)",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
